{
  "name": "kline-screener",
  "version": "2.0.0",
  "license": "UNLICENSED",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "expo start",
    "start:8082": "expo start --port 8082",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo build:android --no-publish",
    "build:development": "expo build:android -t development --no-publish",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.6.0",
    "@react-navigation/native": "^6.1.17",
    "buffer": "^6.0.3",
    "expo": "~57.0.0",
    "expo-background-fetch": "~57.0.6",
    "expo-dev-client": "~57.0.9",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-network": "~57.0.0",
    "expo-sharing": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-task-manager": "~57.0.6",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^29.5.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.5.0",
    "jest-expo": "~57.0.0",
    "metro-react-native-babel-preset": "^0.76.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.2.8",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/e2e/"
    ]
  }
}
